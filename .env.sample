# Postgres configuration
# Username for the database
POSTGRES_USER=your_db_user
# Password for the database
POSTGRES_PASSWORD=your_db_password
# Sync hostname for the database (e.g., localhost or an IP address)
POSTGRES_HOST_SYNC=localhost
# Hostname for the database (e.g., localhost or an IP address)
POSTGRES_HOST=postgres
# Port number for the database (default for PostgreSQL is 5432)
POSTGRES_PORT=5432
# Sync port number for the database (default for PostgreSQL is 5432) (for Docker)
POSTGRES_LOCAL_PORT=5432
# Name of the database
POSTGRES_DB=your_db_name

#Redis config
REDIS_HOST=redis
REDIS_LOCAL_PORT=6379
REDIS_PORT=6379

#Fast API application
# Hostname or IP address to bind your FastAPI application to
HOST=0.0.0.0
# Port number your FastAPI application will run on
PORT=8000
# Local port number your FastAPI application will run on (for Docker)
LOCAL_PORT=8000
# Set to 'true' to enable automatic reloading of your FastAPI application on code changes
RELOAD=true
# This variable specifies which origins (websites) are allowed to make cross-origin requests to your FastAPI application
ALLOWED_ORIGINS=urls
# Documentation basic auth credentials
DOCS_USER=user
DOCS_PASSWORD=password

# The secret key used to sign and verify JWT tokens
AUTH_SECRET_KEY=secret_key
# The algorithm used for signing JWT tokens (e.g., HS256)
AUTH_ALGORITHM=algorithm
